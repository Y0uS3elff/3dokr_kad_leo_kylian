FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build

WORKDIR /src

COPY Worker.csproj .
RUN dotnet restore

COPY Program.cs .
RUN dotnet publish -c Release --no-restore -o /app

FROM mcr.microsoft.com/dotnet/runtime:10.0-alpine AS runtime

WORKDIR /app
COPY --from=build /app .

USER app

CMD ["dotnet", "Worker.dll"]
