FROM node:18-alpine

ENV NODE_ENV=production

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --only=production

COPY server.js .
COPY views ./views

USER node

EXPOSE 8888

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
  CMD ["wget", "-q", "--spider", "http://127.0.0.1:8888/"]

CMD ["node", "server.js"]